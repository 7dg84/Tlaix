# Postgres
POSTGRES_DB=tlaix
POSTGRES_USER=tlaix
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=db
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,app.localhost

# CORS and CSRF
CORS_ALLOWED_ORIGIN=http://nginx-proxy-manager:80,http://app.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://app.localhost/

# Cloudflare Tunnel (Opcional en desarrollo local)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Settings del Proyecto
COMPANY=Tlaix
